<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.1.dtd">
<suite name="API automation suite">
    <!-- Local runs use QA. TestNG lets -Denvironment=int override this value. -->
    <parameter name="environment" value="qa"/>

    <listeners>
        <listener class-name="support.SuiteConfigListener"/>
        <listener class-name="support.DestructiveTestGuard"/>
        <listener class-name="support.TestLifecycleLogger"/>
    </listeners>

    <test name="Jenkins API suite">
        <!-- These classes produce exactly 100 TestNG invocations through their data providers. -->
        <classes>
            <class name="health.ServiceHealthTest"/>
            <class name="users.UserServiceCoverageTest"/>
            <class name="authentication.AuthenticationServiceTest"/>
            <class name="products.ProductServiceTest"/>
            <class name="orders.OrderServiceTest"/>
            <class name="payments.PaymentServiceTest"/>
            <class name="testsupport.TestSupportServiceTest"/>
           <class name="gateway.GatewayServiceTest"/>
            <class name="endtoend.CheckoutJourneyTest"/>
        </classes>
    </test>
</suite>
